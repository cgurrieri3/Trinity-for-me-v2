          "plugin": "AMap.Scale,AMap.ToolBar"
        },
        "getOption": "let sData = [];\nlet sTime = [];\ndata.series.map((s) => {\n  sData = s.fields.find((f) => f.type === 'number').values.buffer || s.fields.find((f) => f.type === 'number').values;\n  sTime = s.fields.find((f) => f.type === 'time').values.buffer || s.fields.find((f) => f.type === 'time').values;\n\n});\n\nreturn {\n  series: [\n    {\n      name: 'hour',\n      type: 'gauge',\n      startAngle: 90,\n      endAngle: -270,\n      min: 0,\n      max: 360,\n      splitNumber: 8,\n      clockwise: true,\n      axisLine: {\n        lineStyle: {\n          width: 15,\n          color: [[1, 'rgba(0,0,0,0.7)']],\n          shadowColor: 'rgba(0, 0, 0, 0.5)',\n          shadowBlur: 15\n        }\n      },\n      splitLine: {\n        lineStyle: {\n          shadowColor: 'rgba(0, 0, 0, 0.3)',\n          shadowBlur: 3,\n          shadowOffsetX: 1,\n          shadowOffsetY: 2\n        }\n      },\n      axisLabel: {\n        fontSize: 25,\n        distance: 45,\n        formatter: function (value) {\n          if (value === 360) {\n            return '';\n          }\n          if (value === 0) {\n            return 'N';\n          }\n          if (value === 45) {\n            return 'NE';\n          }\n          if (value === 90) {\n            return 'E';\n          }\n          if (value === 135) {\n            return 'SE';\n          }\n          if (value === 180) {\n            return 'S';\n          }\n          if (value === 225) {\n            return 'SW';\n          }\n          if (value === 270) {\n            return 'W';\n          }\n          if (value === 315) {\n            return 'NW';\n          }\n          return value + '';\n        }\n      },\n      pointer: {\n        width: 12,\n        length: '77%',\n        offsetCenter: [0, '8%'],\n        itemStyle: {\n          color: '#57A341',\n          shadowColor: 'rgba(0, 0, 0, 0.3)',\n          shadowBlur: 8,\n          shadowOffsetX: 2,\n          shadowOffsetY: 4\n        }\n      },\n      detail: {\n        valueAnimation: true,\n        formatter: function (value) {\n          return '{value|' + value.toFixed(0) + '}{unit|o}';\n        },\n        offsetCenter: ['100%', '100%'],\n        rich: {\n          value: {\n            fontSize: 35,\n            fontWeight: 'bolder',\n            color: '#57A341',\n          },\n          unit: {\n            fontSize: 20,\n            color: '#57A341',\n            padding: [0, 0, 35, 5]\n          }\n        }\n      },\n      title: {\n        offsetCenter: [0, '30%']\n      },\n      data: [\n        {\n          value: sData\n        }\n      ]\n    },\n  ]\n};\n\n\n\n",
