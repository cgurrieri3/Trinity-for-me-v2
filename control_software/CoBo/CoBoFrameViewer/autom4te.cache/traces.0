  # Define MOC flags
  AC_CACHE_CHECK([for flags to use with moc], [at_cv_env_QT_MOCFLAGS],
  [at_cv_env_QT_MOCFLAGS=`echo $at_cv_env_QT_INCPATH | sed "s/-isystem /-I/g"`])
