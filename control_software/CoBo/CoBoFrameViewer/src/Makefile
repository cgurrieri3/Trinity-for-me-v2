.hh.moc.cpp:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@
.h.moc.cpp:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@

.hh.moc.cc:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@
.h.moc.cc:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@

.hh.moc.cxx:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@
.h.moc.cxx:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@

.hh.moc.C:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@
.h.moc.C:
	$(moc_verbose)$(MOC) $(QT_MOCFLAGS) $< -o $@

.ui.ui.hh:
	$(uic_verbose)$(UIC) $< -o $@

.ui.ui.h:
	$(uic_verbose)$(UIC) $< -o $@

.qrc.qrc.cpp:
	$(rcc_verbose)$(RCC) -name `echo "$<" | sed 's#\([^/]*/\)*\([^/]*\)\.qrc#\2#'` $< -o $@ # sed extracts the filename from the path

.qrc.qrc.cc:
	$(rcc_verbose)$(RCC) -name `echo "$<" | sed 's#\([^/]*/\)*\([^/]*\)\.qrc#\2#'` $< -o $@

.qrc.qrc.cxx:
	$(rcc_verbose)$(RCC) -name `echo "$<" | sed 's#\([^/]*/\)*\([^/]*\)\.qrc#\2#'` $< -o $@

.qrc.qrc.C:
	$(rcc_verbose)$(RCC) -name `echo "$<" | sed 's#\([^/]*/\)*\([^/]*\)\.qrc#\2#'` $< -o $@

