Bootstrap: docker
From: python:3.10-trixie

%post
	chmod 777 /tmp
	apt-get update -y
	apt-get install -y \
		git \
		cmake \
		python3 \
		python3-pip \

	python3 -m pip install --upgrade pip
	pip install numpy pandas ephem datetime matplotlib watchdog pdfplumber

%environment
	export PATH=/usr/local/bin:$PATH
  
