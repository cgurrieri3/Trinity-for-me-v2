container_image = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/containers/python3_10.sif 
# your container to use
# My very first HTCondor submit file

# Specify your executable (single binary or a script that runs several

#  commands) and arguments to be passed to jobs. 

#  $(Process) will be a integer number for each job, starting with "0"

#  and increasing for the relevant number of jobs.


executable = run_condor.sh
 # name of the bash script or python or root 

arguments = $(Date)
# needs to be passed to the script - can be nothing, filename

# Specify the name of the log, standard error, and standard output (or "screen output") files. Wherever you see $(Cluster), HTCondor will insert the 

#  queue number assigned to this set of jobs at the time of submission.

log = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/AncillaryData/Data2/.logs/HT_condor_$(Date).log 
# HTCondor log

error = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/AncillaryData/Data2/.logs/Program_$(Date).err 
#Standard Error - program and HTCondor errors

output = /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/AncillaryData/Data2/.logs/Program_$(Date).out 
# program terminal output (not output files)

# This lines *would* be used if there were any other filesr the executable to use.

transfer_input_files = /storage/osg-otte1/shared/TrinityDemonstrator/MiscData/StateMessages/cos4a-10345/$(Date), /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/AncillaryData/Data2/DailyData2file.py, /storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/AncillaryData/Data2/run_condor.sh,/storage/osg-otte1/shared/TrinityDemonstrator/DataAnalysis/containers/python3_10.sif 
#any file that needs to included for the job - everything minus executable
# HTCondor will transfer the executable
# Examples
# Containers (.sif)
# Datafiles
# input files
# references (mappings)
# add in comma seperation

# Transfer any output files created by the job back to the submit machine.
#  - should_transfer_files = YES tells HTCondor to stage files.
#  - when_to_transfer_output = ON_EXIT_OR_EVICT will transfer on normal exit or if the job is evicted.
#  - transfer_output_files lists files (comma-separated) to transfer back. Use wildcards where supported
#    or include a directory (HTCondor will create it under the job sandbox). You can reference
#    $(Cluster) and $(Process) so outputs are unique per job.
# Example: create per-job result files named results_$(Cluster)_$(Process).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
# List any files or directories produced by your job that you want returned. Replace the
# example below with the real filenames your job produces; multiple files separated by commas.
#transfer_output_files = results_$(Cluster)_$(Process).tar.gz, summary_$(Cluster)_$(Process).txt
transfer_output_files = statemessages$(Date).csv


# Specify Job duration category as "Medium" (expected runtime <10 hr) or "Long" (expected runtime <20 hr). 

#+JobDurationCategory = "Medium"
# OSpool match jobs by length -- long jobs go to faster hardware
# Tell HTCondor requirements (e.g., operating system) your job needs, 

# what amount of compute resources each job will need on the computer where it runs.

#requirements = (OSGVO_OS_STRING == "RHEL 9")
# jobs need on redhat specific version (os, also be architeture/hardware things no us)

# resources requests
# these jobs will only run on 1 node
# multi node is not possible (independent jobs)

request_cpus = 1
 # these are PER JOB

request_memory = 1GB 
# these are PER JOB

# space for all files input and output and intermediate files
request_disk = 5GB 
# these are PER JOB

# Tell HTCondor to run 3 instances of our job:
###----------#####
# Queue! HAS TO BE THE LAST LINE
###----------#####
# MAGICAL
# synatax 
# queue + num - que this many identical jobs (EXACT  SAME JOB)
# use case - executable can create independent jobs (script creates difference between jobs)
# randomw number simulations 
queue 1
 

